{
  "_comment": "复制到 ~/.config/invest-wiki/llm.json（仓库外，天然不入库），填好后 verify-cli 实跑生效。base_url 为 OpenAI 兼容 chat-completions 端点；api_key_env 是放 key 的环境变量名（key 本身不入此文件）。",
  "backends": {
    "deepseek-lite": {
      "base_url": "https://api.deepseek.com/v1",
      "model": "deepseek-chat",
      "api_key_env": "DEEPSEEK_API_KEY",
      "temperature": 0
    },
    "deepseek": {
      "base_url": "https://api.deepseek.com/v1",
      "model": "deepseek-reasoner",
      "api_key_env": "DEEPSEEK_API_KEY",
      "temperature": 0
    },
    "hermes-or": {
      "base_url": "https://openrouter.ai/api/v1",
      "model": "nousresearch/hermes-4-405b",
      "api_key_env": "OPENROUTER_API_KEY",
      "temperature": 0
    }
  },
  "verifier": {
    "l3": "deepseek-lite",
    "value-invest": "deepseek",
    "arbiter": "deepseek",
    "default": "deepseek"
  }
}
