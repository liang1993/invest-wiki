<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 申万行业轮动定时刷新。安装: cp 到 ~/Library/LaunchAgents/ 后
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.investwiki.sw-rotation.plist
     卸载: launchctl bootout gui/$(id -u)/com.investwiki.sw-rotation -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.investwiki.sw-rotation</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/bytedance/liang/invest-wiki/skills/scheduled-ingest/scripts/refresh_rotation.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/bytedance/Downloads/invest-charts/launchd.out.log</string>
  <key>StandardErrorPath</key><string>/Users/bytedance/Downloads/invest-charts/launchd.err.log</string>
</dict>
</plist>
